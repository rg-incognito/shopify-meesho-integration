# Copy this file to .env and fill in the values.

# Shopify Dev Dashboard app (App settings -> Credentials). Token is fetched automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternatively, an existing Admin API token (shpat_...) from an older admin-created app:
SHOPIFY_ACCESS_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (send /start to the bot to see yours)
TELEGRAM_ALLOWED_USER_IDS=

# Google service-account JSON key file, and the ID from the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SHEET_ID=

# Hugging Face read token for image models
HF_TOKEN=

# Kaggle API token (Settings -> API -> Generate New Token)
KAGGLE_API_TOKEN=

# Instagram API with Instagram Login (Meta app "Noor Naksh Posts"); long-lived, auto-refreshed by the bot
IG_ACCESS_TOKEN=

# Facebook Page (comment -> DM on Page posts). See fb_token.py; only needed to create data/fb_token.json
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
